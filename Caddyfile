camministore.duckdns.org {
    # Backend OAuth2 login endpoints must reach auth-service directly.
    @auth path /oauth2/* /login/* /logout
    handle @auth {
        reverse_proxy auth-service:8081
    }

    # NextAuth (Auth.js) routes belong to the frontend. This MUST come before
    # the /api/* rule below, otherwise it would be swallowed by the gateway.
    @nextauth path /api/auth/*
    handle @nextauth {
        reverse_proxy frontend:3000
    }

    # Backend REST API (products, orders, ...) goes through the API gateway.
    @api path /api/*
    handle @api {
        reverse_proxy api-gateway:8000
    }

    # Everything else is the Next.js frontend.
    handle {
        reverse_proxy frontend:3000
    }
}
