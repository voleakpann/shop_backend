# Copy to ".env" and fill in real values. NEVER commit the real .env.
# (.env is already git-ignored.)

# --- Database ---
DB_USERNAME=postgres
DB_PASSWORD=change-me

# --- Shared JWT signing secret (same value trusted by all services) ---
# Base64-encoded, at least 256 bits. Generate one with:
#   openssl rand -base64 32
JWT_SECRET=

# --- Google OAuth2 (auth-service) ---
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Stripe (order-service) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Frontend (Next.js) ---
# Public base URL of the deployed site (used for NEXT_PUBLIC_* build args and
# NextAuth's AUTH_URL). Must match the domain in ./Caddyfile.
FRONTEND_BASE_URL=https://camministore.duckdns.org
# NextAuth (Auth.js) session secret. Generate one with:  openssl rand -base64 32
AUTH_SECRET=
# Stripe publishable key (safe to expose; baked into the frontend at build time)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
