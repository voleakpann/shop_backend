# Copy to ".env" and fill in real values. NEVER commit the real .env.
# (.env is already git-ignored.)

# --- Database ---
DB_USERNAME=postgres
DB_PASSWORD=change-me

# --- Shared JWT signing secret (same value trusted by all services) ---
# Base64-encoded, at least 256 bits. Generate one with:
#   openssl rand -base64 32
JWT_SECRET=

# --- Google OAuth2 (auth-service) ---
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Stripe (order-service) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
